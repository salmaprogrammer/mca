# Copy to .env and fill in. Never commit .env.

FLASK_APP=wsgi.py
FLASK_CONFIG=development

# Required in production; DevConfig falls back to an insecure default.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Development defaults to instance/mca-dev.sqlite when unset.
# Production example: postgresql+psycopg://user:pass@host:5432/mca
DATABASE_URL=

# OPEN QUESTION 1 (PLAN.md §8) — how a family sharing one phone is handled.
#   parent_only      = the parent gets the login, the student has none (default)
#   require_distinct = refuse to create unless the two phones differ
FAMILY_SHARED_PHONE_MODE=parent_only

# WhatsApp. There is no API integration and nothing to sign up for: the app
# composes each daily update and the assistant sends it from their own WhatsApp
# via a click-to-chat link. Only change this if wa.me is ever unreachable.
WHATSAPP_LINK_BASE=https://wa.me
